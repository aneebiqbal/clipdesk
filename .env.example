# --- Backend (apps/api) ---
NODE_ENV=development
PORT=8765
# Origin of the Next.js dev server, allowed through CORS
WEB_ORIGIN=http://localhost:3000
# Additional allowed CORS origin (optional)
CORS_ORIGIN=

# Postgres (docker-compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://clipdesk:clipdesk@localhost:5433/clipdesk?schema=public
# Redis (docker-compose maps host 6379)
REDIS_URL=redis://localhost:6379

# Local file storage. Paths are relative to apps/api unless absolute.
UPLOAD_DIR=../../storage/uploads
OUTPUT_DIR=../../storage/output
WORK_DIR=../../storage/work

# Python interpreter that has the worker requirements installed
PYTHON_PATH=python

# Optional: used when no Gemini key is saved in Settings
GEMINI_API_KEY=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8765
