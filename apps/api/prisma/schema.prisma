generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id         String   @id @default(cuid())
  status     Status   @default(QUEUED)
  sourceFile String
  sourceName String
  duration   Float?
  clipCount  Int      @default(3)
  settings   Json     @default("{}")
  progress   Json?
  waveform   Json?
  // Highlight markers for the timeline, stored as { candidates, selected }.
  moments    Json?
  // Run folder name produced by the Python pipeline (used for zip/file paths).
  runName    String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clips      Clip[]

  briefId          String?
  brief            Brief?           @relation(fields: [briefId], references: [id])
  manualTimestamps ManualTimestamp[]
}

model Clip {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Paths are relative to OUTPUT_DIR, e.g. "my-run-01/01_title.mp4".
  filePath    String
  thumbPath   String?
  title       String
  description String
  hook        String?
  outro       String?
  sourceStart Float
  sourceEnd   Float
  duration    Float
  score       Float
  musicTrack  String?
  createdAt   DateTime @default(now())

  topicId      String?
  topic        Topic?    @relation(fields: [topicId], references: [id])
  scriptId     String?
  script       Script?    @relation(fields: [scriptId], references: [id])
  matchScore   Float?
  matchMethod  String?
  seriesGroup  String?
  seriesPart   Int?
  hookVariants Json?
  thumbOptions Json?
  feedback     ClipFeedback[]
}

model Topic {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#FF3B3B")
  isBuiltIn Boolean  @default(false)
  sortOrder Int      @default(0)
  scripts   Script[]
  clips     Clip[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Script {
  id           String   @id @default(cuid())
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title        String?
  description  String
  keywords     String[]
  templateType String?
  sortOrder    Int      @default(0)
  clips        Clip[]
  createdAt    DateTime @default(now())
}

model ManualTimestamp {
  id       String @id @default(cuid())
  jobId    String
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startSec Float
  endSec   Float
  label    String?
}

model Brief {
  id         String   @id @default(cuid())
  name       String
  topicIds   String[]
  isTemplate Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  jobs       Job[]
}

model ClipFeedback {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  action    String
  topicId   String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model Settings {
  id        String @id @default("default")
  clips     Int    @default(3)
  voice     Boolean @default(true)
  music     Boolean @default(true)
  geminiKey String?
  config    Json    @default("{}")
}

enum Status {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
